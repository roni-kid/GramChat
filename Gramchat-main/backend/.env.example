PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/gramchat

# REQUIRED. Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# "production" serves the built frontend from this same server (what `npm run share` uses)
NODE_ENV=development

# Only needed if the frontend is served from a DIFFERENT origin than the API (rare).
# CLIENT_URL=http://localhost:5173

# Login cookies are `Secure` in production (needs https, localhost is exempt).
# Set to false ONLY for plain-http testing over your Wi-Fi (http://192.168.x.x:5001).
# COOKIE_SECURE=false

# Where uploaded photos/files are stored (on your own disk). Default: backend/uploads
# UPLOAD_DIR=./uploads

# ── Calls across different networks ───────────────────────────────────────────
# STUN is free and built in. Some networks (mobile carriers, strict firewalls) also need a TURN relay.
# Free option: create an account at https://www.metered.ca/tools/openrelay/ and paste the values:
# TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_credential
# Self-hosted coturn with `use-auth-secret`: set TURN_URLS and TURN_SECRET instead (short-lived credentials are generated).
