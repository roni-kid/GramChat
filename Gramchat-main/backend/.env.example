PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/gramchat

# REQUIRED. Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# "production" serves the built frontend from this same server (what `npm run share` uses)
NODE_ENV=development

# Only needed if the frontend is served from a DIFFERENT origin than the API (rare).
# CLIENT_URL=http://localhost:5173

# Login cookies are `Secure` in production (needs https, localhost is exempt).
# Set to false ONLY for plain-http testing over your Wi-Fi (http://192.168.x.x:5001).
# COOKIE_SECURE=false

# Where uploaded photos/files are stored (on your own disk). Default: backend/uploads
# UPLOAD_DIR=./uploads

# How many reverse-proxy hops to trust for the client's IP (used by the login / signup rate limits). Default 1 (a tunnel such as
# `npm run share`). If people reach this server DIRECTLY with no proxy in front (e.g. http://192.168.x.x:5001 on your Wi-Fi),
# set false so a client can't fake its address with an X-Forwarded-For header.
# TRUST_PROXY=false

# ── Calls across different networks ───────────────────────────────────────────
# STUN is free and built in. Some networks (mobile carriers, strict firewalls) also need a TURN relay.
# Free option: create an account at https://www.metered.ca/tools/openrelay/ and paste the values:
# TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_credential
# Self-hosted coturn with `use-auth-secret`: set TURN_URLS and TURN_SECRET instead (short-lived credentials are generated).

# ── Push notifications (needs https or localhost, and `npm install --prefix backend` for the web-push package) ──
# VAPID keys identify your server to the browsers' push services. If you leave these empty, keys are created once
# and saved in backend/vapid.json (git-ignored). To use your own:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact address sent to the push services. Use a real email you own (some services may reject placeholders).
# VAPID_SUBJECT=mailto:you@example.com
# Only Google (FCM), Mozilla, Apple and Microsoft push services are accepted as subscription endpoints.
# Add extra hostnames (comma separated) only if you know you need them:
# PUSH_EXTRA_HOSTS=

# ── Disappearing messages: TEST SWITCHES, for `npm run test:api:2e` only ──
# DISAPPEAR_ALLOW_SHORT_TIMERS=1 lets a chat be set to a 5-second timer so the test can watch a message vanish.
# NEVER set it on a real server (the server prints a warning). DISAPPEAR_SWEEP_SECONDS (default 30) is how often the
# background sweeper deletes expired messages; 2 makes the test quicker. Harmless to leave unset.
# DISAPPEAR_ALLOW_SHORT_TIMERS=1
# DISAPPEAR_SWEEP_SECONDS=2
