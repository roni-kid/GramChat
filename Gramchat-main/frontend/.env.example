# Normally you need NOTHING here: in development Vite proxies /api and /socket.io to the backend,
# and in production the backend serves the app, so everything is same-origin.
#
# Only set these if your API/socket server lives on a different origin:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
#
# Point the dev proxy somewhere else (default http://localhost:5001):
# BACKEND_URL=http://localhost:5001
